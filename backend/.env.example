# ==========================================
# FOODCHAIN BACKEND — ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.
# ==========================================

# Your MongoDB connection string (already set in your real .env)
MONGODB_URI=

# Secret used to sign admin login sessions (JWT).
# Use any long random string — e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ------------------------------------------
# SMTP (outgoing email) — required for:
#  - "Thanks for reaching out" auto-replies (newsletter/contact/partnership)
#  - Admin reply-to-customer emails
#  - Forgot/reset password emails
# ------------------------------------------

# Your email provider's SMTP host, e.g. smtp.gmail.com, smtp.zoho.com,
# smtp.titan.email, or your cPanel mail server (mail.yourdomain.com)
SMTP_HOST=

# Usually 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587

# The mailbox username (often the full email address)
SMTP_USER=

# The mailbox password, or an "app password" if your provider requires one
SMTP_PASS=

# What recipients see as the sender name/address (optional — defaults to SMTP_USER)
SMTP_FROM_NAME=FoodChain
SMTP_FROM_EMAIL=

# Where "new submission" alert emails go (optional — leave blank to disable)
ADMIN_NOTIFY_EMAIL=

# ------------------------------------------
# Admin panel
# ------------------------------------------

# The live URL of your /admin folder, no trailing slash.
# Used to build the password-reset link sent by email.
# Example: https://yourdomain.com/admin
ADMIN_PANEL_URL=

# Used only the very first time the server runs, to create the one admin
# account. If left blank, a temporary password is generated and printed
# once in the server console — log in with it, then change it immediately.
DEFAULT_ADMIN_EMAIL=admin@foodchain.com
DEFAULT_ADMIN_PASSWORD=
